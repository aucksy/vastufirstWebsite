---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Zones from '../components/Zones.astro';
import WhyVastuFirst from '../components/WhyVastuFirst.astro';
import NotifyCta from '../components/NotifyCta.astro';
import Footer from '../components/Footer.astro';

const title = 'VastuFirst — vastu before you build';
const description =
  'Sketch your plot, mark north, and get a room-by-room vastu verdict before a single brick is laid. Scored on the 81-pada grid, on your phone, with every rule sourced. Android app, launching soon.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'VastuFirst',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  url: 'https://www.vastufirst.com',
  description:
    'A pre-construction vastu app. Draw or photograph a floor plan, mark north, and get a room-by-room vastu verdict with ranked layout changes. The score is computed on the device.',
  inLanguage: 'en-IN',
  featureList: [
    'Room-by-room vastu verdict on the 81-pada mandala grid',
    '32-position entrance analysis',
    'Provenance tag on every rule',
    'Both readings shown where the schools disagree',
    'Works offline, with the score computed on the phone',
  ],
};
---
<Base title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Marquee />
      <HowItWorks />
      <Zones />
      <WhyVastuFirst />
      <NotifyCta />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import '../scripts/landing';
</script>
