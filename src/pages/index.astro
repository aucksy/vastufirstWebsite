---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Zones from '../components/Zones.astro';
import WhyVastuFirst from '../components/WhyVastuFirst.astro';
import NotifyCta from '../components/NotifyCta.astro';
import Footer from '../components/Footer.astro';

const title = 'VastuFirst — read your home’s vastu from its floor plan';
const description =
  'Photograph your floor plan and the app reads the rooms off it, or draw one by hand. You can correct any room before your score. A room-by-room vastu verdict on the 81-pada grid, house or flat, with every rule sourced. Android app, launching soon.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'VastuFirst',
  applicationCategory: 'LifestyleApplication',
  // ⚠ ANDROID ONLY, and it stays that way until the owner decides otherwise. iPhone is not
  // scheduled, so it must not appear here either — structured data is a promise made to a machine
  // that then repeats it in search results, where nobody will see the caveat we did not write.
  operatingSystem: 'Android',
  url: 'https://www.vastufirst.com',
  description:
    'A vastu app for a home you are buying, building or already living in, and for a flat as well as a house. Photograph a floor plan and it reads the rooms for you, or draw one by hand. You can correct any room before your score. Mark north, and get a room-by-room vastu verdict with ranked fixes. The score is computed on the device.',
  inLanguage: 'en-IN',
  featureList: [
    'Reads a photographed or printed floor plan into rooms, any of which you can correct before your score',
    'Draw a home by hand on a grid instead, if there is no plan to photograph',
    'Room-by-room vastu verdict on the 81-pada mandala grid — eight directions and the centre',
    '32-position entrance analysis',
    'Provenance tag on every rule',
    'Both readings shown where serious sources disagree, and which one your score follows',
    'A flat is never told to change the building around it',
    'Works offline, with the score computed on the phone',
  ],
};
---
<Base title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Marquee />
      <HowItWorks />
      <Zones />
      <WhyVastuFirst />
      <NotifyCta />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import '../scripts/landing';
</script>
