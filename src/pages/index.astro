---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Zones from '../components/Zones.astro';
import WhyVastuFirst from '../components/WhyVastuFirst.astro';
import NotifyCta from '../components/NotifyCta.astro';
import Footer from '../components/Footer.astro';

const title = 'VastuFirst — vastu before you build';
const description =
  'A room-by-room vastu verdict on your floor plan, before a single brick is laid. Photograph the plan, mark north, and read your score on the 81-pada grid, with every rule sourced. Android app, launching soon.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'VastuFirst',
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'Android',
  url: 'https://www.vastufirst.com',
  description:
    'A vastu app for a home you are buying, building or already living in. Photograph a floor plan and it reads the rooms back, or draw one by hand. Mark north, and get a room-by-room vastu verdict with ranked layout changes. The score is computed on the device.',
  inLanguage: 'en-IN',
  featureList: [
    'Reads a photographed or printed floor plan into rooms',
    'Room-by-room vastu verdict on the 81-pada mandala grid',
    '32-position entrance analysis',
    'Provenance tag on every rule',
    'Both readings shown where the schools disagree',
    'Works offline, with the score computed on the phone',
  ],
};
---
<Base title={title} description={description} path="/">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

  <div class="page">
    <Nav />
    <main id="main">
      <Hero />
      <Marquee />
      <HowItWorks />
      <Zones />
      <WhyVastuFirst />
      <NotifyCta />
    </main>
    <Footer />
  </div>
</Base>

<script>
  import '../scripts/landing';
</script>
