---
import CompassDial from './CompassDial.astro';
---
<section class="cta" id="vfNotify">
  <div class="cta__dial" id="vfCtaDial" aria-hidden="true">
    <CompassDial variant="cta" />
  </div>

  <div class="cta__inner">
    <p class="cta__pill" data-reveal="0">
      <span class="pulse-dot" aria-hidden="true"></span>
      Launching soon · Android first
    </p>

    <h2 data-reveal="1">Be the first to build it right</h2>

    <p class="cta__promise" data-reveal="2">
      Leave your email and we’ll send one message when VastuFirst goes live — nothing else.
    </p>

    <!-- A real form with a real action, so it still works with JavaScript off.
         The script upgrades it to a fetch and swaps in the success pill. -->
    <form class="notify-form" id="vfForm" method="post" action="/api/notify" data-reveal="3" novalidate>
      <label class="sr-only" for="vfEmail">Your email address</label>
      <input
        id="vfEmail"
        name="email"
        type="email"
        inputmode="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        aria-describedby="vfFormMsg"
      />
      <button type="submit" id="vfSubmit">Notify me</button>
    </form>

    <p class="notify-error" id="vfFormMsg" role="status" aria-live="polite"></p>

    <div class="notify-success" id="vfSuccess" hidden>
      <svg viewBox="0 0 24 24" style="width:18px;height:18px;flex:0 0 18px" aria-hidden="true">
        <path d="M4 12.5 L9.5 18 L20 6.5" fill="none" stroke="#2E5539" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      You’re on the list. See you at launch.
    </div>

    <div class="cta__stores" data-reveal="4">
      <span class="store-hint">
        <svg viewBox="0 0 24 24" style="width:13px;height:13px;fill:#4B5347;flex:0 0 13px" aria-hidden="true">
          <path d="M17.05 12.04c-.03-2.4 1.96-3.55 2.05-3.61-1.12-1.63-2.86-1.86-3.47-1.88-1.47-.15-2.88.87-3.63.87-.75 0-1.9-.85-3.13-.83-1.61.02-3.1.94-3.92 2.38-1.68 2.9-.43 7.2 1.2 9.56.8 1.15 1.75 2.45 3 2.4 1.2-.05 1.66-.78 3.12-.78 1.45 0 1.86.78 3.13.75 1.3-.02 2.12-1.17 2.91-2.33.92-1.34 1.3-2.64 1.32-2.7-.03-.02-2.54-.98-2.58-3.83z" />
        </svg>
        iOS — after Android
      </span>
      <span class="store-hint">
        <svg viewBox="0 0 24 24" style="width:12px;height:12px;flex:0 0 12px" aria-hidden="true">
          <path d="M5 4 L16 12 L5 20 Z" fill="none" stroke="#4B5347" stroke-width="1.8" stroke-linejoin="round" />
        </svg>
        Android — coming soon
      </span>
    </div>
  </div>
</section>
