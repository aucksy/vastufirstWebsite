---
import CompassDial from './CompassDial.astro';
import PhoneShell from './PhoneShell.astro';
---
<section class="hero" id="vfHero">
  <div class="hero__grid" id="vfHeroGrid" aria-hidden="true">
    <svg viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" focusable="false">
      <g stroke="#D3D6C9" stroke-width="1">
        <line x1="0" y1="200" x2="1200" y2="200" />
        <line x1="0" y1="400" x2="1200" y2="400" />
        <line x1="0" y1="600" x2="1200" y2="600" />
        <line x1="300" y1="0" x2="300" y2="800" />
        <line x1="600" y1="0" x2="600" y2="800" />
        <line x1="900" y1="0" x2="900" y2="800" />
      </g>
    </svg>
  </div>

  <div class="hero__dial" id="vfHeroDial" aria-hidden="true">
    <CompassDial variant="hero" />
  </div>

  <div class="hero__cols">
    <div>
      <p class="badge-pill" data-reveal="0">
        <svg viewBox="0 0 24 24" style="width:13px;height:13px;flex:0 0 13px" aria-hidden="true">
          <path d="M12 2 L15 12 L12 10 L9 12 Z" fill="#7A9E7E" />
          <circle cx="12" cy="15" r="2" fill="#C9A227" />
        </svg>
        For homes not yet built
      </p>

      <h1 class="h1" data-reveal="1"><em>Vastu</em> before<br />the concrete.</h1>

      <p class="hero__sub" data-reveal="2">
        Sketch your plot, mark north, and get a room-by-room vastu verdict — before a single brick is
        laid. Every rule names its source, and the whole score is worked out on your phone.
      </p>

      <div class="hero__actions" data-reveal="3">
        <div class="store-badge">
          <svg viewBox="0 0 24 24" style="width:24px;height:24px;fill:#F8F6F0;flex:0 0 24px" aria-hidden="true">
            <path d="M17.05 12.04c-.03-2.4 1.96-3.55 2.05-3.61-1.12-1.63-2.86-1.86-3.47-1.88-1.47-.15-2.88.87-3.63.87-.75 0-1.9-.85-3.13-.83-1.61.02-3.1.94-3.92 2.38-1.68 2.9-.43 7.2 1.2 9.56.8 1.15 1.75 2.45 3 2.4 1.2-.05 1.66-.78 3.12-.78 1.45 0 1.86.78 3.13.75 1.3-.02 2.12-1.17 2.91-2.33.92-1.34 1.3-2.64 1.32-2.7-.03-.02-2.54-.98-2.58-3.83zM14.66 4.9c.66-.8 1.1-1.92.98-3.03-.95.04-2.1.63-2.78 1.43-.61.7-1.15 1.84-1 2.92 1.05.08 2.13-.53 2.8-1.32z" />
          </svg>
          <div>
            <div class="store-badge__over">Coming soon on</div>
            <div class="store-badge__name">App Store</div>
          </div>
        </div>

        <div class="store-badge">
          <svg viewBox="0 0 24 24" style="width:22px;height:22px;flex:0 0 22px" aria-hidden="true">
            <path d="M4 3.5 L15.5 12 L4 20.5 Z" fill="none" stroke="#F8F6F0" stroke-width="1.6" stroke-linejoin="round" />
            <path d="M15.5 12 L19.5 9.4 L21 12 L19.5 14.6 Z" fill="#C9A227" />
          </svg>
          <div>
            <div class="store-badge__over">Coming soon on</div>
            <div class="store-badge__name">Google Play</div>
          </div>
        </div>

        <a class="text-link" href="#vfNotify" data-jump="vfNotify">Get launch access →</a>
      </div>

      <p class="meta-row" data-reveal="4">
        <span>81-pada grid</span>
        <span class="meta-dot" aria-hidden="true"></span>
        <span>Every rule sourced</span>
        <span class="meta-dot" aria-hidden="true"></span>
        <span>No sign-up</span>
      </p>
    </div>

    <div class="hero__phone-cell" data-reveal="2">
      <div class="float-wrap" id="vfFloatWrap">
        <PhoneShell>
          <div class="mn__head">
            <div class="phone__step">Step 2 of 3 · Mark north</div>
            <div class="phone__title">Face the road,<br />hold steady</div>
            <div class="mn__deg">
              <span class="mn__deg-num" id="vfDeg">0°</span>
              <span class="mn__deg-dir" id="vfDir">N</span>
            </div>
          </div>

          <div class="mn__dial">
            <CompassDial variant="phone" groupId="vfPhoneDial" />
          </div>

          <div class="phone__cta">Lock north</div>
        </PhoneShell>
      </div>
    </div>
  </div>

  <div class="scroll-hint" aria-hidden="true">
    <svg viewBox="0 0 22 30" style="width:22px;height:30px" focusable="false">
      <rect x="1" y="1" width="20" height="28" rx="10" fill="none" stroke="#98A08C" stroke-width="1.2" />
      <circle cx="11" cy="9" r="2.4" fill="#C9A227" />
    </svg>
  </div>
</section>
