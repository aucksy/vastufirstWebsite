---
/**
 * The compass dial. One source for all three places it appears — the hero
 * background, the phone screen, and the CTA corner — so the tick geometry can
 * never drift between them.
 *
 * 48 ticks at 7.5° apart; every 12th is a cardinal (long, sage), every 6th is
 * a mid tick. Geometry transcribed from the design file's renderVals().
 */
interface Props {
  variant: 'hero' | 'phone' | 'cta';
  id?: string;
  groupId?: string;
}
const { variant, id, groupId } = Astro.props;

const ticks = Array.from({ length: 48 }, (_, i) => {
  const a = ((i * 7.5 - 90) * Math.PI) / 180;
  const major = i % 12 === 0;
  const mid = i % 6 === 0;
  const r1 = 100;
  const r2 = major ? 88 : mid ? 92 : 96;
  return {
    x1: +(Math.cos(a) * r1).toFixed(2),
    y1: +(Math.sin(a) * r1).toFixed(2),
    x2: +(Math.cos(a) * r2).toFixed(2),
    y2: +(Math.sin(a) * r2).toFixed(2),
    c: major ? '#7A9E7E' : '#C4D0BE',
    w: major ? 1.6 : 0.7,
  };
});

const labels = ['N', 'E', 'S', 'W'].map((t, i) => {
  const a = ((i * 90 - 90) * Math.PI) / 180;
  return {
    t,
    x: +(Math.cos(a) * 76).toFixed(1),
    y: +(Math.sin(a) * 76 + 3).toFixed(1),
  };
});
---

{variant === 'hero' && (
  <svg viewBox="-110 -110 220 220" aria-hidden="true" focusable="false">
    <circle r="104" fill="none" stroke="#D3D6C9" stroke-width=".7" />
    <circle r="86" fill="none" stroke="#C4D0BE" stroke-width=".5" />
    <circle r="58" fill="none" stroke="#D3D6C9" stroke-width=".4" stroke-dasharray="2 3" />
    {ticks.map((t) => (
      <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={t.c} stroke-width={t.w} />
    ))}
    {labels.map((l) => (
      <text
        x={l.x}
        y={l.y}
        fill="#98A08C"
        text-anchor="middle"
        style="font-family:'DM Mono',monospace;font-size:7px;letter-spacing:.14em"
      >{l.t}</text>
    ))}
  </svg>
)}

{variant === 'phone' && (
  <svg viewBox="-110 -110 220 220" aria-hidden="true" focusable="false" id={id}>
    <g id={groupId}>
      <circle r="100" fill="#EFF2EA" />
      <circle r="100" fill="none" stroke="#C4D0BE" stroke-width="1" />
      <circle r="72" fill="none" stroke="#D3D6C9" stroke-width=".6" />
      {ticks.map((t) => (
        <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={t.c} stroke-width={t.w} />
      ))}
      {labels.map((l) => (
        <text
          x={l.x}
          y={l.y}
          fill="#4B5347"
          text-anchor="middle"
          style="font-family:'DM Mono',monospace;font-size:9px;letter-spacing:.1em"
        >{l.t}</text>
      ))}
    </g>
    {/* Needle and hub sit outside the rotating group — they stay put. */}
    <path d="M0 -66 L10 -32 L0 -39 L-10 -32 Z" fill="#7A9E7E" />
    <path d="M0 66 L10 32 L0 39 L-10 32 Z" fill="#EFF2EA" stroke="#C4D0BE" stroke-width="1" />
    <circle r="7" fill="#C9A227" />
    <circle r="7" fill="none" stroke="#F8F6F0" stroke-width="2" />
  </svg>
)}

{variant === 'cta' && (
  <svg viewBox="-110 -110 220 220" aria-hidden="true" focusable="false">
    <circle r="104" fill="none" stroke="#D3D6C9" stroke-width=".8" />
    <circle r="80" fill="none" stroke="#C4D0BE" stroke-width=".6" />
    {ticks.map((t) => (
      <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke={t.c} stroke-width={t.w} />
    ))}
  </svg>
)}
