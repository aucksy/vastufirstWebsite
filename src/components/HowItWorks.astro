---
import PhoneShell from './PhoneShell.astro';

/**
 * The three screens are the app's OWN rendered screens, copied from the goldens
 * the Android project records in CI (`app/src/androidUnitTest/roborazzi/`) and
 * shrunk to a web size by `tools/make-images.mjs`. They were hand-drawn SVG
 * approximations before, which is a lookalike of a product that exists: if a
 * screen changes in the app, re-run that tool rather than redrawing anything.
 */
const steps = [
  {
    n: '01',
    title: 'Scan your plan',
    body:
      'Photograph a printed floor plan and the app reads the rooms straight off it. You check what it read before anything is scored. No plan yet? Draw one on a grid instead.',
  },
  {
    n: '02',
    title: 'Mark north',
    body:
      'Point your phone at the road or type the bearing. Which way the house faces earns nothing and costs nothing. What counts is where the front door falls, on one of 32 named positions.',
  },
  {
    n: '03',
    title: 'Get the verdict',
    body:
      'A room-by-room score with ranked fixes. Each fix is tagged with where its rule comes from, and anything that cannot move gets a remedy instead.',
  },
];

const screens = [
  {
    src: '/screens/scan.webp',
    alt: 'The app showing the rooms it read from a scanned floor plan, each with its direction and whether it is already right.',
  },
  {
    src: '/screens/north.webp',
    alt: 'The app asking which way is north, with a dial to drag over the plan.',
  },
  {
    src: '/screens/report.webp',
    alt: 'The app’s report: a score out of ten, how many rooms read well, and the first fix to make.',
  },
];
---
<section id="vfHow">
  <div class="how__wrap" id="vfHowWrap">
    <div class="how__pane" id="vfHowPane">
      <div class="how__cols" id="vfHowCols">

        <div class="how__phone-cell">
          <div class="how__ring" id="vfHowRing" aria-hidden="true"></div>

          <PhoneShell id="vfHowPhone" class="how__phone">
            {screens.map((s, i) => (
              <div class="how__screen" id={`vfScr${i}`}>
                <img src={s.src} alt={s.alt} width="620" height="1377" decoding="async" />
              </div>
            ))}
          </PhoneShell>
        </div>

        <div class="how__copy">
          <p class="kicker">How it works</p>
          <h2 class="h2">Three steps.<br />Before one brick.</h2>

          <div class="steps">
            {steps.map((s, i) => (
              <div class="step" id={`vfStep${i}`}>
                <span class="step__num">{s.n}</span>
                <div>
                  <div class="step__title">{s.title}</div>
                  <p class="step__body">{s.body}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="dashes" aria-hidden="true">
            <span class="dash" id="vfDot0"></span>
            <span class="dash" id="vfDot1"></span>
            <span class="dash" id="vfDot2"></span>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
